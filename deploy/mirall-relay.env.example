# /etc/mirall-relay.env — chmod 600, owned by root.
# Every value here has a --flag equivalent; see `mirall-relay --help`.

# --- identity -------------------------------------------------------------
# The seed IS the relay's identity. Generate with `mirall-relay keygen`.
# Prefer the file over MIRALL_RELAY_SEED: env vars leak into process listings.
MIRALL_RELAY_SEED_FILE=/var/lib/mirall-relay/seed
# A read-only mounted secret (Docker/Compose/Kubernetes). Checked before
# SEED_FILE and never written to; a malformed one is a hard error rather than a
# silent re-key.
# MIRALL_RELAY_SEED_SECRET_FILE=/run/secrets/relay_seed
# MIRALL_RELAY_SEED=

# --- networking -----------------------------------------------------------
MIRALL_RELAY_HOST=0.0.0.0
MIRALL_RELAY_PORT=49737
# Set only once you have verified a public IP with unfiltered UDP.
# MIRALL_RELAY_ASSUME_REACHABLE=true
# Override the DHT bootstrap. Leave unset for the public mainline DHT; set it
# only for a private/testing network.
# MIRALL_RELAY_BOOTSTRAP=host:port,host:port
# true = do not join the DHT routing table. A public relay should stay false so
# it participates as a stable node.
# MIRALL_RELAY_EPHEMERAL=false

# --- admin / metrics (keep off the public internet) -----------------------
MIRALL_RELAY_ADMIN_HOST=127.0.0.1
MIRALL_RELAY_ADMIN_PORT=9200

# --- labels ---------------------------------------------------------------
MIRALL_RELAY_REGION=eu-fsn1
MIRALL_RELAY_OPERATOR=example
MIRALL_RELAY_LOG_LEVEL=info

# --- caps (defaults shown; every relayed byte costs you egress) -----------
# Byte and rate caps apply PER DIRECTION of a relayed connection.
# NOTE: this counts sessions per PEER DHT KEY, and a device uses one key for all
# of its relayed connections. A Mirall client runs two planes, so relaying to N
# peers costs 2xN sessions against one key. 64 allows a device to relay to roughly
# 32 peers; lower it only if you are rationing a very constrained relay.
MIRALL_RELAY_MAX_SESSIONS_PER_KEY=64
MIRALL_RELAY_MAX_ACTIVE_LINKS=2000
MIRALL_RELAY_MAX_LINK_BYTES=512MB
MIRALL_RELAY_MAX_LINK_RATE=4MiB
MIRALL_RELAY_MAX_LINK_MS=3600000
MIRALL_RELAY_MAX_PENDING=10000
MIRALL_RELAY_SESSION_RATE=120
# How long a link may sustain a rate above MAX_LINK_RATE before it is torn down.
# A short burst is normal traffic; only a sustained overrun is abuse.
MIRALL_RELAY_OVER_RATE_GRACE_MS=5000
# How often the meter samples byte counters to enforce the caps above.
MIRALL_RELAY_METER_MS=1000

# --- access control -------------------------------------------------------
# Comma- or space-separated z-base-32 or hex public keys, validated at startup.
#
# ALLOWLIST makes the relay PRIVATE: only these keys may connect. BOTH peers of a
# relayed connection must be listed — each end dials the relay independently, so
# listing only one locks the pair out. Note the key matched is the peer's DHT node
# key, which a Mirall client regenerates on every app start; allowlisting only
# works for peers whose DHT identity you pin yourself.
#
# BANLIST keeps the relay public but refuses these specific keys. This is the one
# to reach for during an incident.
#
# An empty value means UNSET, not "allow nobody".
# MIRALL_RELAY_ALLOWLIST=
# MIRALL_RELAY_BANLIST=
