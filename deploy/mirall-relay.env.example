# /etc/mirall-relay.env — chmod 600, owned by root.
# Every value here has a --flag equivalent; see `mirall-relay --help`.

# --- identity -------------------------------------------------------------
# The seed IS the relay's identity. Generate with `mirall-relay keygen`.
# Prefer the file over MIRALL_RELAY_SEED: env vars leak into process listings.
MIRALL_RELAY_SEED_FILE=/var/lib/mirall-relay/seed
# A read-only mounted secret (Docker/Compose/Kubernetes). Checked before
# SEED_FILE and never written to; a malformed one is a hard error rather than a
# silent re-key.
# MIRALL_RELAY_SEED_SECRET_FILE=/run/secrets/relay_seed
# MIRALL_RELAY_SEED=

# --- networking -----------------------------------------------------------
MIRALL_RELAY_HOST=0.0.0.0
MIRALL_RELAY_PORT=49737
# Set only once you have verified a public IP with unfiltered UDP.
# MIRALL_RELAY_ASSUME_REACHABLE=true
# Override the DHT bootstrap. Leave unset for the public mainline DHT; set it
# only for a private/testing network.
# MIRALL_RELAY_BOOTSTRAP=host:port,host:port
# true = do not join the DHT routing table. A public relay should stay false so
# it participates as a stable node.
# MIRALL_RELAY_EPHEMERAL=false

# --- admin / metrics (keep off the public internet) -----------------------
MIRALL_RELAY_ADMIN_HOST=127.0.0.1
MIRALL_RELAY_ADMIN_PORT=9200
# The browser status page at http://<admin>/ — the public key with a copy button
# and a QR, the reachability verdict in plain language, and the live counters.
# Set false to leave only /healthz, /readyz, /metrics and the capability doc.
MIRALL_RELAY_ADMIN_UI=true
# Host header values to accept on the browser surface, in addition to loopback
# names and IP literals. Setting this ALSO turns the DNS-rebinding check on for a
# non-loopback bind — which is the only way to protect a container that binds
# 0.0.0.0 and is published to the host's loopback. The check never applies to
# /healthz, /readyz, /metrics or the capability doc.
# MIRALL_RELAY_ADMIN_ALLOWED_HOSTS=relay.internal
#
# The token-gated write surface at /admin/* — mint and revoke invites, ban a key.
# The anonymous status page above is unchanged and stays read-only; this is a
# separate, authenticated path because minting an invite emits a SECRET.
# Set false to remove it entirely (the CLI still works over `docker exec`).
MIRALL_RELAY_ADMIN_WRITE=true
# Where the bearer token lives. Generated 0600 on the first boot that needs one
# and logged EXACTLY once, on that boot — copy it from the log. Back it up
# alongside the seed, or delete the file to have a new one minted.
MIRALL_RELAY_ADMIN_TOKEN_FILE=/var/lib/mirall-relay/admin-token
# Overrides the file. Prefer the file: env vars leak into `docker inspect`,
# process listings and crash reports, exactly as with the seed.
# MIRALL_RELAY_ADMIN_TOKEN=

# --- labels ---------------------------------------------------------------
MIRALL_RELAY_REGION=eu-fsn1
MIRALL_RELAY_OPERATOR=example
MIRALL_RELAY_LOG_LEVEL=info

# --- caps (defaults shown; every relayed byte costs you egress) -----------
# Byte and rate caps apply PER DIRECTION of a relayed connection.
# NOTE: this counts sessions per PEER DHT KEY, and a device uses one key for all
# of its relayed connections. A Mirall client runs two planes, so relaying to N
# peers costs 2xN sessions against one key. 64 allows a device to relay to roughly
# 32 peers; lower it only if you are rationing a very constrained relay.
MIRALL_RELAY_MAX_SESSIONS_PER_KEY=64
MIRALL_RELAY_MAX_ACTIVE_LINKS=2000
MIRALL_RELAY_MAX_LINK_BYTES=512MB
MIRALL_RELAY_MAX_LINK_RATE=4MiB
MIRALL_RELAY_MAX_LINK_MS=3600000
MIRALL_RELAY_MAX_PENDING=10000
MIRALL_RELAY_SESSION_RATE=120
# How long a link may sustain a rate above MAX_LINK_RATE before it is torn down.
# A short burst is normal traffic; only a sustained overrun is abuse.
MIRALL_RELAY_OVER_RATE_GRACE_MS=5000
# How often the meter samples byte counters to enforce the caps above.
MIRALL_RELAY_METER_MS=1000

# --- access control -------------------------------------------------------
# open   = anyone holding this relay's public key may connect. BANLIST and the
#          caps are your only limits.
# invite = only members on the roster (and any static ALLOWLIST keys) may
#          connect. An EMPTY roster in this mode admits NOBODY, deliberately:
#          revoking the last member must never silently reopen the relay to the
#          internet. The status page says so in plain language.
MIRALL_RELAY_ACCESS=open
#
# The member roster. AS SECRET AS THE SEED — it holds every member's seed, so it
# takes the same 0600 mode, the same backup rule and the same care. Losing it
# locks out every member; leaking it hands over every membership.
MIRALL_RELAY_ROSTER_FILE=/var/lib/mirall-relay/members.json
#
# Mint and revoke with the CLI, against the same file the relay is reading:
#   mirall-relay invite create ben
#   mirall-relay invite list
#   mirall-relay invite revoke ben
# A running relay picks up an out-of-process change within about five seconds and
# drops the revoked member's live sessions.
#
# Comma- or space-separated z-base-32 or hex public keys, validated at startup.
#
# ALLOWLIST is the static, config-managed half of the same admission set; the
# effective set is the union of it and the roster. On its own — with ACCESS still
# open — it keeps its original meaning and makes the relay private to that list.
# BOTH peers of a relayed connection must be admitted: each end dials the relay
# independently, so listing only one locks the pair out.
#
# BANLIST keeps the relay public but refuses these specific keys. This is the one
# to reach for during an incident.
#
# An empty value means UNSET, not "allow nobody" — which is what ACCESS=invite is
# for.
# MIRALL_RELAY_ALLOWLIST=
# MIRALL_RELAY_BANLIST=
